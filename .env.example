# Production site URL — used for sitemap, robots, canonical URLs, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://rweru.com

# Resend API key — enables email notifications when someone contacts, RSVPs, or subscribes.
# Existing forms log when unset; Playground forms show a WhatsApp fallback instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=RweruSynapse <onboarding@resend.dev>
CONTACT_TO_EMAIL=rwerusynapse@gmail.com

# Playground mobile performance checks. Enable PageSpeed Insights API in Google Cloud.
# Without a key, checks use Google's unauthenticated quota and may be unavailable.
PAGESPEED_API_KEY=

# International WhatsApp business number (digits only; optional leading +).
NEXT_PUBLIC_WHATSAPP_NUMBER=250793126602

# Plausible analytics — set to your domain to load the tracking script.
# Leave unset to skip analytics entirely (no third-party script loads).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Search engine site verification codes — get these from Google Search Console
# and Bing Webmaster Tools after adding rweru.com as a property. Required to
# submit the sitemap and request indexing so the site ranks for brand queries.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
